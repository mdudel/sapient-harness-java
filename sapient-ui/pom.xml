<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mdudel.sapient</groupId>
        <artifactId>sapient-harness-java</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>sapient-ui</artifactId>
    <name>SAPIENT UI (JavaFX)</name>
    <description>
        JavaFX desktop UI: configure Receivers (TCP servers) and Transmitters
        (TCP clients), watch live SAPIENT traffic, edit JSON templates.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.mdudel.sapient</groupId>
            <artifactId>sapient-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mdudel.sapient</groupId>
            <artifactId>sapient-net</artifactId>
        </dependency>
        <!--
            protobuf-java at compile scope. sapient-core has it as a compile
            dep, but Maven's reactor doesn't reliably surface sibling-module
            transitive dependencies to sapient-ui's compile classpath from a
            clean state (`mvn -o clean compile -pl sapient-ui -am` fails
            without this). Sapient-ui code (TransmittersPane, AutoStartRecipe,
            MessageDialogs, SavedSensorConfig, ...) references protobuf types
            like SensorGenerator.Config's StatusReport.System enum. Declaring
            it explicitly here is the offline-friendly fix. Added 2026-08-06.
        -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-feather-pack</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
        </dependency>
        <!-- Test-scoped: SessionStore back-compat + JSON round-trip tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.mdudel.sapient.ui.SapientHarnessApp</mainClass>
                </configuration>
            </plugin>
            <!-- Fat JAR for double-click distribution. Note: JavaFX in a fat JAR
                 works but is not the officially blessed path; for release use
                 jlink/jpackage. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.mdudel.sapient.ui.Launcher</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
